{
  "version": 2,
  "functions": {
    "api/*.js": {
      "includeFiles": "data/*.json",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {"key":"Cache-Control","value":"no-store"},
        {"key":"X-Content-Type-Options","value":"nosniff"}
      ]
    }
  ]
}
